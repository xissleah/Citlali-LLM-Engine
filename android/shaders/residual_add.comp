#version 450

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { uint input_words[]; };
layout(set = 0, binding = 1, std430) readonly buffer DeltaBuffer { uint delta_words[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { uint output_words[]; };
layout(push_constant) uniform Parameters { uint elements; } p;

void main() {
    uint word = gl_GlobalInvocationID.x;
    if (word >= (p.elements + 1U) / 2U) return;
    vec2 value = unpackHalf2x16(input_words[word]) + unpackHalf2x16(delta_words[word]);
    if (word * 2U + 1U >= p.elements) value.y = 0.0;
    output_words[word] = packHalf2x16(value);
}
