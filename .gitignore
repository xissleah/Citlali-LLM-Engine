# ============================================================
#  citlali-cuda  .gitignore
#  原则：只提交「源码 + 构建脚本 + 文档」，产物和权重一律不入库
# ============================================================

# ---------- 1. 模型权重（体积 7GB+，绝对不能入库）----------
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# ---------- 2. 构建目录 ----------
build/
cmake-build-*/
out/
dist/
android/build/

# ---------- 3. CMake 生成物 ----------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
*.ninja
.ninja_deps
.ninja_log

# ---------- 4. 编译中间件与产物 ----------
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.exp
*.pdb
*.ilk
*.spv

# ---------- 5. 性能分析产物（NSight / ncu）----------
nsys_reports/
*.nsys-rep
*.ncu-rep
*.sqlite
*.qdrep

# ---------- 6. IDE / 编辑器 ----------
.idea/
.vscode/
.vs/
.clangd
.cache/
*.iml
*.swp
*~

# ---------- 7. 操作系统杂项 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 8. 本地私有配置（如果有）----------
*.local
*.local.*
.env

# ---------- 9. 个人笔记（仅本地，不公开）----------
开发日志.txt
个人笔记*.txt
TODO*.txt
